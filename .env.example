# Copie para .env (que NÃO vai para o git) e ajuste para o seu homelab.
# O world.yaml lê estas variáveis com a sintaxe ${NOME:-padrão}.
MQTT_HOST=mqtt.local
MQTT_PORT=1883
MQTT_USER=
MQTT_PASSWORD=
OLLAMA_URL=http://oraculo.local:11434
OLLAMA_MODEL=qwen2.5:7b
DW_DB_PATH=var/world.sqlite
DW_SERVER_HOST=0.0.0.0
DW_SERVER_PORT=8000
DW_SEED=
# Fase 3: pasta dos nascidos (vazio = data/characters/born) e cache do clima
DW_BORN_DIR=
DW_WEATHER_CACHE=var/clima.json
# Fase 4: Ollama ligado/desligado (false = nem tenta) e o endereço da API para o tools.cli
DW_OLLAMA_ATIVO=true
DW_API_URL=http://localhost:8000
